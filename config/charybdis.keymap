/*
 * Charybdis 4x6 BT — layout EN/PT-BR
 * Requer layout do SO: "English (US, intl., with dead keys)" (us+intl)
 *
 * Camadas:
 *   0 BASE  QWERTY
 *   1 NAV   setas/F-keys/mídia — segurar faz o trackball rolar (scroll-layers = <1>)
 *   2 SYM   símbolos + aspas/crase/til "literais" (sem dead key)
 *   3 ACE   acentos PT: agudo na vogal, circunflexo acima, til abaixo
 *   4 ADJ   Bluetooth/RGB/bootloader (NAV + SYM juntos)
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ACE  3
#define ADJ  4

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <30>;
    delay-ms = <0>;
};

// dead key + letra (us+intl). Shift segurado vira maiúscula: ~ e ^ já usam Shift.
#define DEAD(name, dead, key) \
    name: name { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        bindings = <&kp dead &kp key>; \
    };

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <64>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <64>;
    };

    macros {
        DEAD(m_atil, TILDE, A)
        DEAD(m_otil, TILDE, O)
        DEAD(m_acir, CARET, A)
        DEAD(m_ecir, CARET, E)
        DEAD(m_ocir, CARET, O)
        // ` com Shift vira ~ no us+intl, por isso À precisa de mod-morph
        DEAD(m_acrase, GRAVE, A)
        DEAD(m_acrase_shift, GRAVE, LS(A))
    };

    behaviors {
        a_crase: a_crase {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_acrase>, <&m_acrase_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5        &kp N6        &kp N7    &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T         &kp Y         &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LCTRL  &kp A   &kp S   &kp D     &kp F      &kp G         &kp H         &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B         &kp N         &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp SPACE  &mo NAV       &lt SYM ENTER &mo ACE
                                     &mkp LCLK  &mkp RCLK     &kp LGUI
            >;
            sensor-bindings = <&scroll_vertical_encoder &scroll_horizontal_encoder>;
        };

        nav {
            display-name = "Nav";
            bindings = <
&kp F1    &kp F2  &kp F3    &kp F4     &kp F5    &kp F6        &kp F7      &kp F8      &kp F9      &kp F10    &kp F11   &kp F12
&kp CAPS  &trans  &trans    &trans     &trans    &trans        &kp PG_UP   &kp HOME    &kp UP      &kp END    &kp DEL   &kp PSCRN
&trans    &trans  &mkp MB4  &mkp MCLK  &mkp MB5  &trans        &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT  &kp BSPC  &trans
&trans    &trans  &trans    &trans     &trans    &trans        &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT
                            &trans     &trans    &trans        &trans      &trans
                                       &trans    &trans        &trans
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&trans  &trans         &trans         &trans       &trans       &trans        &trans         &trans     &trans     &trans     &trans     &trans
&trans  &kp EXCL       &kp AT         &kp HASH     &kp DLLR     &kp PRCNT     &kp RA(CARET)  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp EQUAL
&trans  &kp RA(GRAVE)  &kp RA(TILDE)  &kp RA(SQT)  &kp RA(DQT)  &kp PIPE      &kp BSLH       &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT   &kp PLUS
&trans  &kp LT         &kp GT         &kp UNDER    &kp MINUS    &trans        &trans         &trans     &trans     &trans     &trans     &trans
                                      &trans       &trans       &trans        &trans         &trans
                                                   &trans       &trans        &trans
            >;
        };

        ace {
            display-name = "Acentos";
            bindings = <
&trans  &trans      &trans    &m_ecir      &trans  &trans        &trans  &trans     &trans     &m_ocir    &trans  &trans
&trans  &m_acir     &trans    &kp RA(E)    &trans  &trans        &trans  &kp RA(U)  &kp RA(I)  &kp RA(O)  &trans  &trans
&trans  &kp RA(A)   &a_crase  &trans       &trans  &trans        &trans  &trans     &trans     &m_otil    &trans  &trans
&trans  &m_atil     &trans    &kp RA(COMMA) &trans &trans        &trans  &trans     &trans     &trans     &trans  &trans
                              &trans       &trans  &trans        &trans  &trans
                                           &trans  &trans        &trans
            >;
        };

        adj {
            display-name = "Adjust";
            bindings = <
&bootloader  &none            &none            &none            &none            &none              &none        &none        &none  &none  &none  &bootloader
&sys_reset   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &none        &none        &none  &none  &none  &sys_reset
&trans       &bt BT_PRV       &bt BT_NXT       &none            &none            &bt BT_CLR         &out OUT_USB &out OUT_BLE &none  &none  &none  &none
&trans       &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI    &none        &none        &none  &none  &none  &none
                                               &trans           &trans           &trans             &trans       &trans
                                                                &trans           &trans             &trans
            >;
        };

        // livres para editar pelo ZMK Studio
        extra1 {
            status = "reserved";
            bindings = <
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans   &trans &trans
                            &trans &trans   &trans
            >;
        };

        extra2 {
            status = "reserved";
            bindings = <
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                     &trans &trans &trans   &trans &trans
                            &trans &trans   &trans
            >;
        };
    };
};
